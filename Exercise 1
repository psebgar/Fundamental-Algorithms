#Exercise 2
nombre_archivo = input("Enter the name of the text file: ")

try:
    with open(nombre_archivo, 'r') as file:
        contenido = file.read()
        # Se convierte el texto del archivo a una lista de números
        numeros_archivo = [float(x) for x in contenido.split()]
        print("\n--- FILE RESULTS ---")
        print(f"Numbers read from '{nombre_archivo}':", numeros_archivo)

except FileNotFoundError:
    print(f"\nError: The file '{nombre_archivo}' does not exist.")
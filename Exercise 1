name_archivo = input("Enter the name of the text file: ")

try:
    with open(name_archivo, 'r') as file:
        content = file.read()
        numbers_archivo = [float(x) for x in content.split()]
        print(f"Numbers read from '{name_archivo}':", numbers_archivo)

except FileNotFoundError:
    print(f" The file '{name_archivo}' does not exist.")